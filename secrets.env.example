# Copy to secrets.env and fill in. Never commit secrets.env.

# Infinite Campus parent portal. Use the origin from your browser's login URL,
# and the hidden `appName` field on that page (often called the district id).
IC_BASE_URL=https://campus.yourdistrict.edu
IC_DISTRICT=your_appName
IC_USERNAME=
IC_PASSWORD=

# Home Assistant. Create a long-lived access token in your HA profile.
HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN=

# Optional. If unset, every student on the parent account is published.
# Format: campusFirstName:Display Name,campusFirstName:Display Name
# Entity ids use a slug of the display name (e.g. Ann Marie -> ann_marie).
# CAMPUS_KIDS=alex:Alex,sam:Sam

# Optional. Local timezone and poll clock (24h hours, comma-separated).
# TZ=America/New_York
# CAMPUS_POLL_HOURS=6,18
# CAMPUS_RECENT_DAYS=14
# CAMPUS_RUN_ON_START=1
